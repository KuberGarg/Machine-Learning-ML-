import scipy.stats as st
import numpy as np


row1 = np.array([40,45,25,10])
row2 = np.array([35,30,20,30])


sum_r1 = np.sum(row1)
sum_r2 = np.sum(row2)

sum_r1, sum_r2


sum_cal = row1 + row2
sum_cal


exp = []
for i in sum_r1, sum_r2:
    for j in sum_cal:
        value = (i*j)/235
        exp.append(value)

exp


obj = np.array([40,45,25,10,35,30,20,30])
obj


chi_cal = np.sum(np.square(obj-exp)/exp)
chi_cal


df = (2-1)*(4-1)
df


chi_table = st.chi2.ppf(1-0.05,3)
chi_table



