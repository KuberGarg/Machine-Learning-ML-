import pandas as pd


dataset = pd.read_csv("polynomial.csv")


dataset.head(3)


x = dataset.iloc[:, :-1]
y = dataset["Salary"]


from sklearn.model_selection import train_test_split

x_train, x_test, y_train, y_test = train_test_split(x, y, random_state=42, test_size=0.2)


from sklearn.tree import DecisionTreeRegressor


dt = DecisionTreeRegressor()
dt.fit(x_train, y_train)


dt.score(x_train, y_train) * 100, dt.score(x_test, y_test) * 100


from sklearn.model_selection import GridSearchCV, RandomizedSearchCV


df = { "criterion": ["squared_error", "absolute_error", "poisson"],
    "splitter": ["best", "random"],
    "max_depth": [i for i in range(2, 20)]}


gd = GridSearchCV(DecisionTreeRegressor(),param_grid=df)
gd.fit(x_train, y_train)


gd.best_params_


dt = DecisionTreeRegressor(criterion="squared_error",splitter="best",max_depth=9)
dt.fit(x_train, y_train)


dt.score(x_train, y_train) * 100, dt.score(x_test, y_test) * 100


rd = RandomizedSearchCV(DecisionTreeRegressor(),param_distributions=df,n_iter=20,random_state=42)
rd.fit(x_train, y_train)


rd.best_params_


rd.best_score_


dt = DecisionTreeRegressor(criterion="squared_error",splitter="best",max_depth=11)
dt.fit(x_train, y_train)


dt.score(x_train, y_train) * 100, dt.score(x_test, y_test) * 100



