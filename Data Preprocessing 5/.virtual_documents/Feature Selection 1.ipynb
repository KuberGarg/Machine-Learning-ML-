import pandas as pd
from mlxtend.feature_selection import SequentialFeatureSelector
from sklearn.linear_model import LogisticRegression



dataset = pd.read_csv("Data/diabetes.csv")



x = dataset.iloc[:, :-1]
y = dataset["Outcome"]



lr = LogisticRegression(max_iter=1000)









fs = SequentialFeatureSelector(lr,k_features=4,forward=False,scoring="accuracy",cv=2)

fs.fit(x, y)



print(fs.feature_names)
print(fs.k_feature_names_)


print(fs.k_score_)





fs = SequentialFeatureSelector(lr,k_features=3,forward=False,scoring="accuracy",cv=2)
fs.fit(x, y)


print(fs.feature_names)
print(fs.k_feature_names_)


print(fs.k_score_)





fs = SequentialFeatureSelector(lr,k_features=2,forward=False,scoring="accuracy",cv=2)
fs.fit(x, y)


print(fs.feature_names)
print(fs.k_feature_names_)


print(fs.k_score_)



